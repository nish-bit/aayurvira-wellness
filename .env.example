# Public site URL (used for SEO metadata, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://aayurvirawellness.com

# WhatsApp number in international format, no + or spaces (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919528218326

# Google Apps Script Web App URL (see GOOGLE_SHEETS_SETUP.md). Server-side
# only — never prefix this with NEXT_PUBLIC_. Copy your own deployed Apps
# Script Web App URL here in .env.local (do not commit real values here).
GOOGLE_SHEETS_ENDPOINT=https://script.google.com/macros/s/AKfycbxrnsRsNOdqtlZD7k8OcPEGq-VoNY6ZiBRLKAVWr2h1mGY9EbZpxB2SWVwIWbKawguj/exec

# Business contact info (used on Contact page / footer / structured data)
NEXT_PUBLIC_BUSINESS_PHONE=+91 95282 18326
# Same number in tel: link format (used for the clickable phone link)
NEXT_PUBLIC_BUSINESS_PHONE_TEL=tel:+919528218326
NEXT_PUBLIC_BUSINESS_EMAIL=hello@aayurvirawellness.com

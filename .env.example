# Google Analytics 4 Measurement ID (public — this is meant to be exposed
# to the browser; it is not a secret). Get it from GA4: Admin > Data
# Streams > your web stream > Measurement ID (starts with "G-").
#
# Copy this file to .env.local and fill in the real value.
# Leave it unset/empty to run the site with analytics fully disabled —
# nothing analytics-related loads or errors when this is missing.
NEXT_PUBLIC_GA_ID=

# Google Form enquiry links for each product's "Enquire Now" button.
# Google Forms is the source of truth for validation (see README's
# Product Enquiry Forms section for how to set up the 10-digit Indian
# mobile number validation inside the form itself — the website cannot
# reach into a cross-origin Google-hosted iframe to add its own).
#
# EASIEST SETUP — one form for everything:
# Paste your Google Form's normal "Send > Link" URL (something like
# https://docs.google.com/forms/d/e/XXXXXXXX/viewform) into just this one
# variable, and it's used by every product's "Enquire Now" button. The
# site appends "?embedded=true" itself when showing it in the modal.
NEXT_PUBLIC_GOOGLE_FORM_URL=

# OPTIONAL — a separate form per product instead:
# If you'd rather know which product each enquiry was about, create a
# separate Google Form (same two fields: Name + Phone) for each product
# and paste its link here. A product-specific URL below always takes
# priority over NEXT_PUBLIC_GOOGLE_FORM_URL above; leave these empty to
# just use the one shared form for every product.
#
# Whichever of the vars below (or the shared one above) end up unset for
# a given product, that product's button shows an honest "enquiry form
# coming soon" message instead of a broken embed.
NEXT_PUBLIC_NEURO_VIRA_POWDER_FORM_URL=
NEXT_PUBLIC_NEURO_VIRA_SYRUP_FORM_URL=
NEXT_PUBLIC_NEURO_VIRA_NABHI_OIL_FORM_URL=

# Google Apps Script Web App endpoint that the product enquiry form
# (Name + Phone) POSTs to, writing leads directly into a connected
# Google Sheet. This is NOT a secret — a Web App deployed as "Execute
# as: Me / Access: Anyone" is a public execution endpoint by Google's
# own design, safe to expose in client-side code.
#
# Already has a real, working default baked into src/lib/leadSubmission.ts,
# so you do NOT need to set this to get the current integration working.
# Only set it here if you redeploy the Apps Script and get a new URL.
NEXT_PUBLIC_GOOGLE_SHEETS_ENDPOINT=
